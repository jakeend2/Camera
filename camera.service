[Unit]
Description=MIC 612 camera recorder and PTZ web control
Documentation=https://github.com/jakeend2/Camera
After=network-online.target
Wants=network-online.target
# Give up only after sustained failure, not a burst of restarts.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=pi
Group=pi
SupplementaryGroups=video dialout plugdev
WorkingDirectory=/home/pi/Desktop/Camera
ExecStart=/home/pi/Desktop/Camera/venv/bin/python /home/pi/Desktop/Camera/camera_service.py

Restart=always
RestartSec=5

# SIGTERM lets the service finalise the current .mkv before exiting.
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=45

StandardOutput=journal
StandardError=journal
SyslogIdentifier=camera

# Modest hardening; the service still needs /dev/video0 and /dev/ttyUSB0.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=no
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
