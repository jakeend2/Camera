[Unit]
Description=MIC 612 camera recorder and PTZ web control
Documentation=https://github.com/jakeend2/Camera
After=network-online.target
Wants=network-online.target
# Give up only after sustained failure, not a burst of restarts.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
# A dedicated system account with no shell and no sudo. The service used to
# run as 'pi', who has passwordless sudo - any code execution bug in the web
# app was therefore a straight path to root.
User=camera
Group=camera
SupplementaryGroups=video dialout plugdev
WorkingDirectory=/opt/camera
# MQTT and web credentials live here, outside the repo. The leading '-' means
# a missing file is not an error - the service starts with those features off.
EnvironmentFile=-/etc/camera-service.env
# Nothing should be writing .pyc into an otherwise read-only tree.
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/camera/venv/bin/python /opt/camera/camera_service.py

Restart=always
RestartSec=5

# SIGTERM lets the service finalise the current recording before exiting.
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=45

StandardOutput=journal
StandardError=journal
SyslogIdentifier=camera

# Hardening. The whole filesystem is read-only apart from the two directories
# the service genuinely writes to.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/opt/camera/videos /opt/camera/logs
# Clip scratch and cached playback windows. systemd creates
# /var/cache/camera owned by the service user and makes it writable despite
# ProtectSystem=strict; the service reads $CACHE_DIRECTORY to find it.
CacheDirectory=camera
CacheDirectoryMode=0750
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
