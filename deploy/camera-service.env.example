# Every setting camera_service.py reads, with its built-in default.
#
# The live copy is /etc/camera-service.env, root:camera 0640. This file is the
# reference, not a drop-in: install.sh writes the secrets, and everything else
# only needs to appear if you want to override the default.
#
# QUOTE ANY VALUE CONTAINING SHELL METACHARACTERS. systemd does not care, but
# several deploy scripts `source` this file, and an unquoted password with a
# bracket in it broke every one of them at once.
#
# deploy/checks/docs.py fails if the code grows a setting this file does not
# mention, which is how it stays honest.

# ---------------------------------------------------------------- required --
# Written by install.sh on first run and never regenerated afterwards.
FLASK_SECRET_KEY="<64 hex chars - openssl rand -hex 32>"
WEB_USERNAME="admin"
WEB_PASSWORD_HASH="<set by deploy/rotate-secret.sh web>"

# ------------------------------------------------------------------ MQTT ---
MQTT_HOST="127.0.0.1"
MQTT_PORT="1883"
MQTT_USERNAME="camera"
MQTT_PASSWORD="<generated by install.sh>"
MQTT_PREFIX="camera"           # this service's own topics

# ---------------------------------------------------------------- cameras --
# CAMERAS limits which of the defined cameras actually run; empty means all.
# PRIMARY_CAMERA is the one the un-parameterised routes still refer to.
CAMERAS=""
PRIMARY_CAMERA="mic612"

# -- mic612: analog PTZ over a USB capture dongle, encoded on this box -------
# The defaults below are this machine's hardware. On any other box they are
# wrong, and install.sh detects and writes the real ones.
VIDEO_DEVICE="/dev/v4l/by-id/usb-MACROSILICON_usb_video-video-index0"
CAPTURE_SIZE="1280x720"
CAPTURE_FPS="20"
RECORD_FPS="10"                # the encode is the most expensive thing here
RECORD_BITRATE="2500k"
# Per-camera overrides; each falls back to the plain name above.
CAM_MIC612_SOURCE=""
CAM_MIC612_CAPTURE_SIZE=""
CAM_MIC612_CAPTURE_FPS=""
CAM_MIC612_RECORD_FPS=""
CAM_MIC612_RECORD_BITRATE=""
CAM_MIC612_RETENTION_DAYS=""

# -- backyard: Reolink RLC-510A over RTSP, copied to disk untouched ----------
CAM_BACKYARD_USER="admin"
CAM_BACKYARD_PASS="<the camera's password>"
CAM_BACKYARD_SOURCE="rtsp://192.168.1.126:554/h264Preview_01_main"
CAM_BACKYARD_PREVIEW_SOURCE="rtsp://192.168.1.126:554/h264Preview_01_sub"
# -timeout, NOT -stimeout: verified against ffmpeg 5.1.9. TCP because a
# dropped UDP packet under -c copy is corruption written into the archive.
CAM_BACKYARD_INPUT_EXTRA="-rtsp_transport tcp -timeout 5000000"
# Must match what the camera's Fluent (sub) stream actually sends. Asking for
# more only duplicates frames. Change it on the camera first, then here.
CAM_BACKYARD_PREVIEW_FPS="15"
CAM_BACKYARD_PREVIEW_QUALITY="8"      # mjpeg -q:v, 2 best .. 31 worst
CAM_BACKYARD_PLAY_WINDOW_SECONDS="60"
CAM_BACKYARD_RETENTION_DAYS=""

# ------------------------------------------------------------------ PTZ ----
# Pelco-D over RS-485. With more than one USB-serial adapter present, use the
# stable symlink from deploy/70-serial-adapters.rules - /dev/ttyUSB0 is
# whichever one enumerated first, which is a coin toss at every boot.
SERIAL_PORT="/dev/pelco-d"
SERIAL_BAUD="9600"
DIAGONALS_ENABLED="0"

# ------------------------------------------------------- archive + storage --
RETENTION_DAYS="7"
MIN_FREE_GB="50"
PLAY_WINDOW_SECONDS="120"
CLIP_MAX_SECONDS="1800"
WINDOW_CACHE_MB="1024"
MEDIA_JOBS="3"
CACHE_DIR=""                   # falls back to CACHE_DIRECTORY from systemd
CACHE_DIRECTORY=""             # set by systemd's CacheDirectory=

# ------------------------------------------------------------- live feeds --
PREVIEW_LINGER="60"            # seconds a substream preview outlives its last viewer
STREAM_IDLE_GIVEUP="15"        # give up after this many 2s waits with no frame

# ------------------------------------------------------------------ HTTP ----
TLS_CERT="/etc/camera-tls/server.crt"
TLS_KEY="/etc/camera-tls/server.key"
SERVER_THREADS="32"

# ------------------------------------------------- garage door (ratgdo) -----
# Leave RATGDO_HOST empty and the whole panel disappears.
RATGDO_HOST=""                 # e.g. 192.168.1.127
RATGDO_USER="admin"
RATGDO_PASS=""
RATGDO_POLL="2"
GARAGE_PREFIX="garage"
# The broker identity the ratgdo bridge publishes as - its own user, so it
# cannot write camera or thermostat topics.
RATGDO_MQTT_USER="ratgdo"
RATGDO_MQTT_PASS=""

# ------------------------------------------------------------ thermostat ----
# Z-Wave, via zwave-js-ui. HVAC_NODE follows the node id the controller gave
# the device - it CHANGES if you exclude and re-include, and pointing at a
# node that no longer exists shows its last known values forever.
HVAC_NODE="nodeID_3"
HVAC_PREFIX="hvac"
HVAC_GATEWAY="_CLIENTS/ZWAVE_GATEWAY-zwave-js-ui"
HVAC_MIN_F="45"                # clamped here as well as in the page
HVAC_MAX_F="90"
HVAC_STALE_AFTER="900"         # a reading older than this is not "online"
HVAC_WRITE_TIMEOUT="8"         # seconds to wait for the gateway's verdict

# The broker identity zwave-js-ui itself uses. Read by the deploy scripts and
# by zwave-js-ui's own settings, not by camera_service.py.
ZWAVE_MQTT_USER="zwave"
ZWAVE_MQTT_PASS=""
